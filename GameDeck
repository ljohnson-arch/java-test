import java.util.Arrays
public class GameDeck{
    private int[] deck;

    public GameDeck(){
        this.deck = deck;
    }

    public int[] createDeck(int numOfCards){
        for (int i = 1; i <= numOfCards; i++){
            for (int j = 0; j <= i; j++){
                deck[j] = i;
            }
        }
        return deck;
    } 
}